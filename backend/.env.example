PORT=5001
# Local example. For Render, use your Atlas URI with /ShopIn?appName=ShopIn.
MONGO_URI=mongodb://localhost:27017/ShopIn?appName=ShopIn
JWT_SECRET=replace-with-a-long-random-secret

# Gmail address and a Google App Password (not your normal Gmail password).
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-16-character-google-app-password

CLOUDINARY_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

SAFEPAY_ENV=sandbox
# Get these from the Safepay merchant dashboard. Use sandbox credentials for local development.
SAFEPAY_API_KEY=your-safepay-api-key
SAFEPAY_SECRET_KEY=your-safepay-secret-key
SAFEPAY_WEBHOOK_SECRET=your-safepay-webhook-secret
CLIENT_URL=http://localhost:3000
